{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Docker Go (Delve)",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "remotePath": "/app",
      "port": 2345,
      "host": "127.0.0.1",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Launch Shield (cmd/app)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/app",
      "cwd": "${workspaceFolder}",
      "env": {
        "ENVIRONMENT": "dev",
        "LOG_LEVEL": "debug"
      },
      "args": [],
      "buildFlags": "",
      "dlvToolPath": "${env:HOME}/go/bin/dlv",
      "showLog": true
    }
  ]
}
